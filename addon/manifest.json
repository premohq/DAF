{
  "manifest_version": 3,
  "name": "DAF Helper",
  "version": "1.1.0",
  "description": "Lets Dante's Ad Forge send a bottle photo and prompt to your own Gemini in a background tab and bring the result back.",
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {"default_title": "DAF Helper: open Dante's Ad Forge", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "background": {"service_worker": "background.js"},
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.google.com/*"
  ],
  "content_scripts": [{
    "matches": ["https://premohq.github.io/*", "http://localhost/*", "http://127.0.0.1/*", "file:///*"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }]
}
